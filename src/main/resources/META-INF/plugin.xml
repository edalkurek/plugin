<?xml version="1.0" encoding="UTF-8"?>
<!-- Plugin Configuration File: https://plugins.jetbrains.com/docs/intellij/plugin-configuration-file.html -->
<idea-plugin>
    <!-- Unique identifier of the plugin. It should be FQN, cannot be changed between the plugin versions. -->
    <id>org.example.yk-plugin</id>

    <!-- Public plugin name should be written in Title Case. -->
    <name>YKB Swagger Generator</name>

    <!-- A displayed Vendor name or Organization ID displayed on the Plugins Page. -->
    <vendor url="https://github.com/ykb">YKB</vendor>

    <!-- Description of the plugin displayed on the Plugin Page and IDE Plugin Manager. -->
    <description><![CDATA[
        Generates Java DTO classes and service interface signatures from a Swagger/OpenAPI document.<br>
        Run it from <em>Tools &gt; Swagger Code Generator...</em>.
    ]]></description>

    <!-- Product and plugin compatibility requirements.
         Read more: https://plugins.jetbrains.com/docs/intellij/plugin-compatibility.html -->

    <!-- Core IntelliJ platform module. Available in every IDE (Community + Ultimate). -->
    <depends>com.intellij.modules.platform</depends>
    <!-- Java PSI/JavaPsiFacade is used, so Java support is required (bundled in IDEA Community + Ultimate). -->
    <depends>com.intellij.java</depends>

    <!-- Localised UI strings (e.g. action.<id>.text, action.<id>.description). -->
    <resource-bundle>messages.MyMessageBundle</resource-bundle>

    <!-- Main action added to the Tools menu. Text/description come from the resource bundle. -->
    <actions>
        <action id="org.example.ykplugin.GenerateCodeAction"
                class="org.example.ykplugin.action.GenerateCodeAction">
            <add-to-group group-id="ToolsMenu" anchor="last"/>
        </action>
    </actions>
</idea-plugin>

